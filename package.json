{
  "name": "baseball-stats",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "atlas:validate": "atlas migrate validate --env raw",
    "check": "pnpm lint && pnpm format:check",
    "check:fix": "pnpm lint:fix && pnpm format",
    "dev": "turbo run dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "packageManager": "pnpm@12.20.0"
}
