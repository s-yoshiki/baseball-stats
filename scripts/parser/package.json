{
  "name": "@repo/parser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "atlas-schema": "node --import tsx src/atlas-schema.ts",
    "build-release-metadata": "tsx src/build-release-metadata.ts",
    "scrape": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate-sqlite": "tsx src/validate-sqlite.ts"
  },
  "dependencies": {
    "@repo/baseball-data": "workspace:*",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "kysely": "0.29.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
