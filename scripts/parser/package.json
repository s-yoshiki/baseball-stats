{
  "name": "@repo/parser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "atlas-schema": "node --import tsx src/atlas-schema.ts",
    "build-release-metadata": "tsx src/build-release-metadata.ts",
    "scrape": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate-sqlite": "tsx src/validate-sqlite.ts"
  },
  "dependencies": {
    "@repo/baseball-data": "workspace:*",
    "better-sqlite3": "catalog:",
    "cheerio": "catalog:",
    "kysely": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
