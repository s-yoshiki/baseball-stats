{
  "name": "@repo/parser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "atlas-schema": "node --import tsx src/atlas-schema.ts",
    "export-json": "tsx src/export-json.ts",
    "scrape": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate-sqlite": "tsx src/validate-sqlite.ts",
    "write-sqlite": "tsx src/write-sqlite.ts"
  },
  "dependencies": {
    "@repo/baseball-data": "workspace:*",
    "better-sqlite3": "13.0.2",
    "cheerio": "1.2.0",
    "kysely": "0.29.4"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.3",
    "tsx": "4.22.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
